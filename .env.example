# Firebase Configuration (replace with your Firebase Web App credentials)
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForKinnectAppExample
VITE_FIREBASE_AUTH_DOMAIN=kinnect-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kinnect-app
VITE_FIREBASE_STORAGE_BUCKET=kinnect-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Local Firebase Emulator switch (true for local automated testing, false for production)
VITE_USE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

